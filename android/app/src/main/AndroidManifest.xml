<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- allowBackup="false" : la liste des stations et les mots de passe chiffrés restent sur ce téléphone. -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="openRemoteTRX"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Partage du fichier de test SELCALL (WhatsApp, Signal…) : le cache « selcall/ » seulement, lecture accordée au partage -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Lecteur de QR code (ZXing) : suit l'orientation du téléphone (paysage seul par défaut). -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="android:screenOrientation" />
    </application>
</manifest>
